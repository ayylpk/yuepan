# 复制成 .env 放在 docker-compose.yml 同目录(compose 会自动读它;.env 已在 .gitignore)
#   cp .env.example .env

# web 容器对外端口。服务器上如果有 Caddy/nginx 占着 80,这里就留个高位端口给它反代
WEB_PORT=8080

# 服务器上给「在线看代码」用的仓库目录(宿主机路径,会挂到容器内 /srv/repos)。
# 注意:必须是独立的一份 clone,不要指到部署目录本身 —— 代码页的 git pull 会改这个目录。
# 留空则回落到 ./data/repos(默认是空的,代码页会显示"没数据")
REPOS_HOST_DIR=/srv/repos

# 后端镜像装 git 时用的 Debian apt 源。官方源 deb.debian.org 在国内服务器实测 ~48KB/s,
# 换成国内镜像快三个数量级(腾讯云服务器还可走内网 mirrors.tencentyun.com)。
# 不设则用官方源;国内服务器建议:
# DEBIAN_MIRROR=mirrors.tencentyun.com
# DEBIAN_MIRROR=mirrors.aliyun.com
